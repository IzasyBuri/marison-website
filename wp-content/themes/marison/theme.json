{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 3,
  "settings": {
    "appearanceTools": true,
    "border": {
      "radius": true,
      "customColor": false,
      "customRadius": false,
      "customStyle": false,
      "customWidth": false,
      "radiusSizes": [
        {
          "name": "Small",
          "size": "8px",
          "slug": "small"
        },
        {
          "name": "Medium",
          "size": "12px",
          "slug": "medium"
        },
        {
          "name": "Large",
          "size": "20px",
          "slug": "large"
        }
      ]
    },
    "color": {
      "custom": false,
      "customDuotone": false,
      "customGradient": false,
      "defaultDuotone": false,
      "defaultGradients": false,
      "defaultPalette": false,
      "palette": [
        {
          "color": "#1F6B45",
          "name": "Primary Green",
          "slug": "primary-green"
        },
        {
          "color": "#123D2A",
          "name": "Deep Green",
          "slug": "deep-green"
        },
        {
          "color": "#64B94F",
          "name": "Fresh Green",
          "slug": "fresh-green"
        },
        {
          "color": "#DDEBDD",
          "name": "Soft Sage",
          "slug": "soft-sage"
        },
        {
          "color": "#F7F4EC",
          "name": "Warm Cream",
          "slug": "warm-cream"
        },
        {
          "color": "#20251F",
          "name": "Charcoal",
          "slug": "charcoal"
        },
        {
          "color": "#6E756D",
          "name": "Muted Gray",
          "slug": "muted-gray"
        },
        {
          "color": "#FFFFFF",
          "name": "White",
          "slug": "white"
        }
      ]
    },
    "layout": {
      "contentSize": "720px",
      "wideSize": "1200px"
    },
    "spacing": {
      "customSpacingSize": false,
      "spacingSizes": [
        {
          "name": "Extra Small",
          "size": "0.25rem",
          "slug": "x-small"
        },
        {
          "name": "Small",
          "size": "0.75rem",
          "slug": "small"
        },
        {
          "name": "Medium",
          "size": "1.5rem",
          "slug": "medium"
        },
        {
          "name": "Large",
          "size": "3rem",
          "slug": "large"
        },
        {
          "name": "Extra Large",
          "size": "5rem",
          "slug": "x-large"
        },
        {
          "name": "Extra Extra Large",
          "size": "8rem",
          "slug": "xx-large"
        }
      ],
      "units": ["px", "rem", "%", "vw"]
    },
    "typography": {
      "customFontSize": false,
      "dropCap": false,
      "fontFamilies": [
        {
          "fontFamily": "Plus Jakarta Sans, Inter, ui-sans-serif, system-ui, sans-serif",
          "name": "Marison Sans",
          "slug": "marison-sans"
        }
      ],
      "fontSizes": [
        {
          "name": "Caption",
          "size": "0.8125rem",
          "slug": "caption"
        },
        {
          "name": "Small",
          "size": "0.875rem",
          "slug": "small"
        },
        {
          "name": "Medium",
          "size": "1rem",
          "slug": "medium"
        },
        {
          "name": "Body",
          "size": "1.0625rem",
          "slug": "body"
        },
        {
          "name": "Large",
          "size": "1.5rem",
          "slug": "large"
        },
        {
          "name": "Heading 3",
          "size": "clamp(1.375rem, 2vw, 2rem)",
          "slug": "h3"
        },
        {
          "name": "Heading 2",
          "size": "clamp(1.75rem, 3vw, 2.75rem)",
          "slug": "h2"
        },
        {
          "name": "Heading 1",
          "size": "clamp(2rem, 4vw, 3.5rem)",
          "slug": "h1"
        },
        {
          "name": "Display",
          "size": "clamp(2.25rem, 5vw, 4.5rem)",
          "slug": "display"
        },
        {
          "name": "Extra Large",
          "size": "clamp(2rem, 5vw, 3.5rem)",
          "slug": "x-large"
        }
      ],
      "lineHeight": false
    }
  },
  "styles": {
    "color": {
      "background": "var:preset|color|warm-cream",
      "text": "var:preset|color|charcoal"
    },
    "spacing": {
      "blockGap": "var:preset|spacing|medium"
    },
    "typography": {
      "fontFamily": "var:preset|font-family|marison-sans",
      "fontSize": "var:preset|font-size|body",
      "lineHeight": "1.6"
    },
    "elements": {
      "button": {
        "border": {
          "radius": "var:preset|spacing|small"
        },
        "color": {
          "background": "var:preset|color|primary-green",
          "text": "var:preset|color|white"
        },
        "spacing": {
          "padding": {
            "bottom": "var:preset|spacing|small",
            "left": "var:preset|spacing|medium",
            "right": "var:preset|spacing|medium",
            "top": "var:preset|spacing|small"
          }
        },
        "typography": {
          "fontWeight": "600"
        }
      },
      "link": {
        "color": {
          "text": "var:preset|color|primary-green"
        },
        "typography": {
          "textDecoration": "underline"
        }
      }
    }
  }
}
